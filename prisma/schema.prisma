// =============================================================================
// Prisma Schema - SaaS Invitation Card
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// DOMAIN 1: AUTH & USER (Auth.js Required Models)
// =============================================================================

model User {
  id            String    @id @default(uuid(7))
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // Business relations
  invitations     Invitation[]
  subscriptions   Subscription[]
  transactions    Transaction[]
  entitlements    Entitlement[]
  resellerCredits ResellerCredit[]
  posts           Post[]
}

model Account {
  id                String  @id @default(uuid(7))
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid(7))
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Token reset password (kredensial). `token` menyimpan HASH SHA-256 dari
// token asli yang dikirim via email (token asli tak pernah disimpan mentah).
model PasswordResetToken {
  id        String   @id @default(uuid(7))
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// =============================================================================
// DOMAIN 2: MONETIZATION
// =============================================================================

/// Paket yang dijual di platform. Bisa berupa PLAN (paket utama), ADDON (fitur
/// tambahan a la carte), atau BUNDLE (gabungan beberapa item). Semua tier
/// (FREE/BASIC/PRO/dll) adalah DATA, bukan enum, sehingga harga & isinya bisa
/// diubah dari panel admin tanpa deploy ulang.
model Package {
  id             String      @id @default(uuid(7))
  name           String
  slug           String      @unique
  description    String? // Deskripsi singkat (ditampilkan di kartu harga)
  kind           PackageKind @default(PLAN) // PLAN | ADDON | BUNDLE
  saleType       SaleType    @default(ONE_TIME) // ONE_TIME | SUBSCRIPTION | RESELLER
  price          Int // Harga retail dalam satuan Rupiah
  wholesalePrice Int? // Harga grosir untuk reseller/agency (opsional)
  features       Json // Daftar bullet fitur untuk TAMPILAN (marketing). Gating nyata lewat PackageFeature.
  maxInvitations Int         @default(1) // Kuota undangan (relevan utk SUBSCRIPTION/RESELLER)
  durationDays   Int         @default(180) // Masa aktif dalam hari
  sortOrder      Int         @default(0)
  isHighlighted  Boolean     @default(false) // Tandai sebagai paket "paling populer"
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  packageFeatures PackageFeature[]
  entitlements    Entitlement[]
  subscriptions   Subscription[]
  transactions    Transaction[]
  resellerCredits ResellerCredit[]

  // Relasi bundling (self-relation): sebuah BUNDLE memuat beberapa item paket/add-on.
  bundleItems BundleItem[] @relation("BundleParent") // isi bila paket ini BUNDLE
  inBundles   BundleItem[] @relation("BundleChild") // bundle yang memuat paket ini
}

/// Katalog fitur yang bisa diaktifkan / di-set kuotanya per paket. Menggantikan
/// array string bebas sebagai sumber gating yang machine-readable.
model Feature {
  id          String      @id @default(uuid(7))
  key         String      @unique // Pengenal stabil dipakai di kode, mis. "NO_WATERMARK", "MAX_GUESTS"
  name        String // Nama tampilan, mis. "Tanpa Watermark"
  description String?
  type        FeatureType @default(BOOLEAN) // BOOLEAN = on/off, QUOTA = berangka
  unit        String? // Satuan untuk QUOTA, mis. "tamu", "foto"
  category    String? // Pengelompokan di UI admin
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  packageFeatures PackageFeature[]
}

/// Penghubung Package <-> Feature: fitur apa yang dibawa sebuah paket beserta
/// nilainya (enabled untuk BOOLEAN, limitValue untuk QUOTA).
model PackageFeature {
  id         String  @id @default(uuid(7))
  packageId  String
  featureId  String
  enabled    Boolean @default(true) // Untuk fitur BOOLEAN
  limitValue Int? // Untuk fitur QUOTA (null = tak terbatas)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([packageId, featureId])
  @@index([featureId])
}

/// Isi dari sebuah paket BUNDLE: referensi ke paket/add-on lain yang digabung.
model BundleItem {
  id       String @id @default(uuid(7))
  bundleId String // Paket ber-kind BUNDLE
  itemId   String // Paket (PLAN/ADDON) yang termasuk di dalam bundle
  quantity Int    @default(1)

  bundle Package @relation("BundleParent", fields: [bundleId], references: [id], onDelete: Cascade)
  item   Package @relation("BundleChild", fields: [itemId], references: [id])

  @@unique([bundleId, itemId])
  @@index([itemId])
}

/// Hak akses (entitlement) yang menempel pada SATU undangan — sumber kebenaran
/// gating per-undangan, menggantikan pengecekan "apakah user punya langganan
/// aktif". Bisa lahir dari pembelian eceran, langganan, alokasi reseller, atau
/// pemberian manual admin. `featuresSnapshot` menyimpan salinan fitur+kuota saat
/// hak diberikan agar tahan terhadap perubahan paket di kemudian hari.
model Entitlement {
  id               String            @id @default(uuid(7))
  invitationId     String
  ownerUserId      String // Pemilik hak (pasangan utk eceran, agency utk reseller)
  packageId        String? // Referensi paket sumber (nullable agar tahan bila paket dihapus)
  source           EntitlementSource @default(PURCHASE)
  status           EntitlementStatus @default(ACTIVE)
  validUntil       DateTime
  featuresSnapshot Json // Salinan fitur+kuota saat hak diberikan
  subscriptionId   String? // Diisi bila source = SUBSCRIPTION (soft ref)
  transactionId    String? // Diisi bila berasal dari pembayaran (soft ref)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  owner      User       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  package    Package?   @relation(fields: [packageId], references: [id])

  @@index([invitationId, status, validUntil])
  @@index([ownerUserId, status])
  @@index([packageId])
}

/// Status langganan aktif user
model Subscription {
  id         String             @id @default(uuid(7))
  userId     String
  packageId  String
  status     SubscriptionStatus @default(ACTIVE)
  startDate  DateTime           @default(now())
  validUntil DateTime
  quotaUsed  Int                @default(0) // Jumlah undangan yang sudah dibuat
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id])

  // Query "langganan aktif" (userId + status + validUntil) sangat sering dipakai
  @@index([userId, status, validUntil])
  @@index([packageId])
}

/// Riwayat transaksi pembayaran
model Transaction {
  id           String  @id @default(uuid(7))
  userId       String
  packageId    String
  invitationId String? // Diisi bila pembelian untuk SATU undangan (eceran); null = langganan
  amount       Int // Dalam satuan Rupiah (total = harga satuan x quantity)
  currency     String  @default("IDR")
  quantity     Int     @default(1) // Jumlah lisensi (pembelian reseller); 1 utk pembelian biasa

  // Identitas pembayaran
  midtransOrderId       String  @unique // Order ID sisi merchant (ref utama)
  midtransToken         String? // Snap token
  midtransTransactionId String? @unique // transaction_id dari Midtrans (untuk rekonsiliasi)
  paymentType           String? // gopay | bank_transfer | qris | credit_card | ...
  paymentUrl            String?
  paymentMeta           Json? // Detail instruksi Core API (VA/QR/biller/expiry) utk ditampilkan ulang di halaman pembayaran

  status    TransactionStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  package    Package     @relation(fields: [packageId], references: [id])
  // Undangan dipertahankan bila dihapus → SetNull (riwayat pembayaran tetap utuh).
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  // midtransOrderId & midtransTransactionId sudah otomatis ter-index oleh @unique
  @@index([userId, createdAt]) // riwayat transaksi user terurut terbaru
  @@index([packageId])
  @@index([invitationId])
  @@index([status])
}

/// Saldo kredit/lisensi reseller milik AGENCY. Satu baris = satu batch pembelian
/// paket (harga grosir). Agency "mengalokasikan" 1 kredit ke undangan klien →
/// menerbitkan Entitlement(RESELLER) & menaikkan quantityUsed.
model ResellerCredit {
  id            String   @id @default(uuid(7))
  agencyUserId  String // Pemilik kredit (role AGENCY)
  packageId     String // Paket yang direpresentasikan kredit ini
  quantityTotal Int // Jumlah lisensi dibeli
  quantityUsed  Int      @default(0) // Lisensi yang sudah dialokasikan
  transactionId String? // Asal pembayaran (soft ref)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agency  User    @relation(fields: [agencyUserId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id])

  // Query "batch yang masih punya sisa" per agency+paket, terlama dulu
  @@index([agencyUserId, packageId])
}

// =============================================================================
// DOMAIN 3: INVITATION CORE
// =============================================================================

/// Master tema desain undangan
model Theme {
  id            String   @id @default(uuid(7))
  name          String
  slug          String   @unique
  description   String?
  category      String? // Kategori katalog (Elegant/Floral/Minimalist/Blue/Nature)
  thumbnailUrl  String?
  previewImages Json? // Array of preview image URLs
  isPremium     Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invitations Invitation[]
}

/// Undangan digital milik user
model Invitation {
  id      String @id @default(uuid(7))
  slug    String @unique // URL publik undangan
  userId  String
  themeId String

  // Info Pasangan Pria & Wanita
  title String // Contoh: "Pernikahan William & Eleanor"

  groomNickname String  @default("")
  groomFullName String  @default("")
  groomFather   String?
  groomMother   String?
  groomPhotoUrl String?

  brideNickname String  @default("")
  brideFullName String  @default("")
  brideFather   String?
  brideMother   String?
  bridePhotoUrl String?

  // Media, Galeri & Konten
  coverUrl      String? // Foto Cover Utama / Prewedding
  galleryLayout GalleryLayout @default(CAROUSEL)
  quotes        String?       @db.Text
  openingText   String?       @db.Text

  // Kado Fisik
  physicalGiftAddress  String? @db.Text
  physicalGiftReceiver String?
  physicalGiftPhone    String?

  // Musik Latar
  musicUrl       String? // URL file MP3
  musicTitle     String? // Judul Musik
  isMusicEnabled Boolean @default(true)

  // Status
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme       Theme        @relation(fields: [themeId], references: [id])
  events      Event[]
  loveStories LoveStory[]
  galleries   Gallery[]
  gifts       Gift[]
  guests       Guest[]
  rsvps        RSVP[]
  visitorLogs  VisitorLog[]
  entitlements Entitlement[]
  transactions Transaction[]

  // slug sudah ter-index oleh @unique
  @@index([userId, createdAt]) // daftar undangan user terurut terbaru
  @@index([themeId])
}

/// Acara dalam undangan (Akad, Resepsi, dll)
model Event {
  id           String   @id @default(uuid(7))
  invitationId String
  name         String // Contoh: "Akad Nikah" | "Resepsi"
  date         DateTime
  startTime    String // Format "HH:MM" (lebih fleksibel dari Time)
  endTime      String?
  locationName String
  address      String   @db.Text
  mapUrl       String? // Google Maps embed URL
  mapLat       Float?
  mapLng       Float?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, sortOrder])
}

/// Cerita perjalanan cinta pasangan
model LoveStory {
  id           String   @id @default(uuid(7))
  invitationId String
  title        String
  date         String? // Format bebas: "Januari 2020"
  description  String   @db.Text
  imageUrl     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, sortOrder])
}

/// Galeri foto/video undangan
model Gallery {
  id           String    @id @default(uuid(7))
  invitationId String
  mediaUrl     String
  thumbnailUrl String?
  type         MediaType @default(PHOTO)
  caption      String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, sortOrder])
}

/// Amplop digital / rekening tujuan hadiah
model Gift {
  id            String   @id @default(uuid(7))
  invitationId  String
  type          GiftType // BANK | EWALLET | PHYSICAL
  providerName  String // Contoh: "BCA", "GoPay", "Tokopedia"
  accountName   String
  accountNumber String?
  qrCodeUrl     String?
  note          String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, sortOrder])
}

// =============================================================================
// DOMAIN 4: GUEST & RSVP
// =============================================================================

/// Daftar tamu undangan
model Guest {
  id           String    @id @default(uuid(7))
  invitationId String
  name         String
  whatsapp     String?
  uniqueCode   String    @unique // Digunakan untuk link personal & QR check-in
  isOpened     Boolean   @default(false)
  openedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  rsvp       RSVP?

  // uniqueCode sudah ter-index oleh @unique
  @@index([invitationId])
}

/// Konfirmasi kehadiran tamu
model RSVP {
  id           String     @id @default(uuid(7))
  invitationId String
  guestId      String?    @unique // Nullable: tamu anonim bisa RSVP tanpa uniqueCode
  name         String? // Jika tamu anonim
  attendance   Attendance
  pax          Int        @default(1)
  message      String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest      Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([invitationId, createdAt])
}

// =============================================================================
// DOMAIN 5: ANALYTICS
// =============================================================================

/// Log kunjungan halaman undangan
model VisitorLog {
  id           String   @id @default(uuid(7))
  invitationId String
  ipAddress    String? // Di-hash sebelum disimpan untuk privasi
  userAgent    String?  @db.Text
  referrer     String?
  visitedAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  // Analitik per-undangan dalam rentang waktu
  @@index([invitationId, visitedAt])
}

// =============================================================================
// DOMAIN 6: BLOG (SEO)
// =============================================================================

/// Artikel blog untuk SEO
model Post {
  id           String    @id @default(uuid(7))
  slug         String    @unique
  title        String
  excerpt      String?   @db.Text
  content      String    @db.Text
  thumbnailUrl String?
  authorId     String
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id])

  // slug sudah ter-index oleh @unique
  @@index([authorId])
  @@index([isPublished])
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  USER // Calon pengantin / pengguna biasa
  AGENCY // Wedding Organizer / Studio Foto
  ADMIN // Admin platform
  SUPER_ADMIN // Akses penuh ke CMS
}

enum GalleryLayout {
  CAROUSEL
  MASONRY
}

enum PackageKind {
  PLAN // Paket utama
  ADDON // Fitur tambahan a la carte
  BUNDLE // Gabungan beberapa paket/add-on
}

enum SaleType {
  ONE_TIME // Bayar sekali (eceran per undangan)
  SUBSCRIPTION // Langganan berkala (bulanan/tahunan)
  RESELLER // Dijual ke agency dengan harga grosir
}

enum FeatureType {
  BOOLEAN // Fitur on/off
  QUOTA // Fitur berangka (punya limitValue)
}

enum EntitlementSource {
  PURCHASE // Pembelian eceran satu kali
  SUBSCRIPTION // Berasal dari langganan aktif
  RESELLER // Dialokasikan oleh agency/reseller
  ADMIN // Diberikan manual oleh super admin
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum MediaType {
  PHOTO
  VIDEO
}

enum GiftType {
  BANK
  EWALLET
  PHYSICAL
}

enum Attendance {
  YES
  NO
  MAYBE
}

// =============================================================================
// DOMAIN 7: TEMPLATES & SETTINGS (Dikelola oleh Super Admin)
// =============================================================================

/// Templat ayat dan kutipan pilihan untuk undangan
model QuoteTemplate {
  id        String   @id @default(uuid(7))
  title     String // Contoh: "QS. Ar-Rum Ayat 21 (Islami)"
  content   String   @db.Text
  category  String   @default("General") // "Islami" | "Kristiani" | "Modern" | "Umum"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Pustaka lagu latar belakang pernikahan
model MusicTemplate {
  id        String   @id @default(uuid(7))
  title     String // Contoh: "Payung Teduh - Akad"
  url       String // URL file audio .mp3
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Daftar Tanya Jawab (FAQ) di Landing Page
model FAQ {
  id        String   @id @default(uuid(7))
  question  String // Pertanyaan
  answer    String   @db.Text // Jawaban
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Pengaturan Global Sistem (Key-Value) seperti nomor WhatsApp
model SystemSetting {
  id          String   @id @default(uuid(7))
  key         String   @unique // Contoh: "CS_WHATSAPP_NUMBER"
  value       String // Nilai pengaturan
  description String? // Deskripsi kegunaan
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
