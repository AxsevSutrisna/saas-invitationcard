// =============================================================================
// Prisma Schema - SaaS Invitation Card
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// DOMAIN 1: AUTH & USER (Auth.js Required Models)
// =============================================================================

model User {
  id            String    @id @default(uuid(7))
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // Business relations
  invitations   Invitation[]
  subscriptions Subscription[]
  transactions  Transaction[]
  posts         Post[]
}

model Account {
  id                String  @id @default(uuid(7))
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid(7))
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Token reset password (kredensial). `token` menyimpan HASH SHA-256 dari
// token asli yang dikirim via email (token asli tak pernah disimpan mentah).
model PasswordResetToken {
  id        String   @id @default(uuid(7))
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// =============================================================================
// DOMAIN 2: MONETIZATION
// =============================================================================

/// Paket langganan yang tersedia di platform
model Package {
  id             String      @id @default(uuid(7))
  name           String
  slug           String      @unique
  type           PackageType @default(ONE_TIME)
  price          Int // Dalam satuan Rupiah
  features       Json // Array of feature string
  maxInvitations Int         @default(1)
  durationDays   Int         @default(180) // Masa aktif dalam hari
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  subscriptions Subscription[]
  transactions  Transaction[]
}

/// Status langganan aktif user
model Subscription {
  id         String             @id @default(uuid(7))
  userId     String
  packageId  String
  status     SubscriptionStatus @default(ACTIVE)
  startDate  DateTime           @default(now())
  validUntil DateTime
  quotaUsed  Int                @default(0) // Jumlah undangan yang sudah dibuat
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id])

  // Query "langganan aktif" (userId + status + validUntil) sangat sering dipakai
  @@index([userId, status, validUntil])
  @@index([packageId])
}

/// Riwayat transaksi pembayaran
model Transaction {
  id        String @id @default(uuid(7))
  userId    String
  packageId String
  amount    Int // Dalam satuan Rupiah
  currency  String @default("IDR")

  // Identitas pembayaran
  midtransOrderId       String  @unique // Order ID sisi merchant (ref utama)
  midtransToken         String? // Snap token
  midtransTransactionId String? @unique // transaction_id dari Midtrans (untuk rekonsiliasi)
  paymentType           String? // gopay | bank_transfer | qris | credit_card | ...
  paymentUrl            String?

  status    TransactionStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id])

  // midtransOrderId & midtransTransactionId sudah otomatis ter-index oleh @unique
  @@index([userId, createdAt]) // riwayat transaksi user terurut terbaru
  @@index([packageId])
  @@index([status])
}

// =============================================================================
// DOMAIN 3: INVITATION CORE
// =============================================================================

/// Master tema desain undangan
model Theme {
  id            String   @id @default(uuid(7))
  name          String
  slug          String   @unique
  description   String?
  category      String? // Kategori katalog (Elegant/Floral/Minimalist/Blue/Nature)
  thumbnailUrl  String?
  previewImages Json? // Array of preview image URLs
  isPremium     Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invitations Invitation[]
}

/// Undangan digital milik user
model Invitation {
  id      String @id @default(uuid(7))
  slug    String @unique // URL publik undangan
  userId  String
  themeId String

  // Info Pasangan Pria & Wanita
  title String // Contoh: "Pernikahan William & Eleanor"

  groomNickname String  @default("")
  groomFullName String  @default("")
  groomFather   String?
  groomMother   String?
  groomPhotoUrl String?

  brideNickname String  @default("")
  brideFullName String  @default("")
  brideFather   String?
  brideMother   String?
  bridePhotoUrl String?

  // Media, Galeri & Konten
  coverUrl      String? // Foto Cover Utama / Prewedding
  galleryLayout GalleryLayout @default(CAROUSEL)
  quotes        String?       @db.Text
  openingText   String?       @db.Text

  // Kado Fisik
  physicalGiftAddress  String? @db.Text
  physicalGiftReceiver String?
  physicalGiftPhone    String?

  // Musik Latar
  musicUrl       String? // URL file MP3
  musicTitle     String? // Judul Musik
  isMusicEnabled Boolean @default(true)

  // Status
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme       Theme        @relation(fields: [themeId], references: [id])
  events      Event[]
  loveStories LoveStory[]
  galleries   Gallery[]
  gifts       Gift[]
  guests      Guest[]
  rsvps       RSVP[]
  visitorLogs VisitorLog[]

  // slug sudah ter-index oleh @unique
  @@index([userId, createdAt]) // daftar undangan user terurut terbaru
  @@index([themeId])
}

/// Acara dalam undangan (Akad, Resepsi, dll)
model Event {
  id           String   @id @default(uuid(7))
  invitationId String
  name         String // Contoh: "Akad Nikah" | "Resepsi"
  date         DateTime
  startTime    String // Format "HH:MM" (lebih fleksibel dari Time)
  endTime      String?
  locationName String
  address      String   @db.Text
  mapUrl       String? // Google Maps embed URL
  mapLat       Float?
  mapLng       Float?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, sortOrder])
}

/// Cerita perjalanan cinta pasangan
model LoveStory {
  id           String   @id @default(uuid(7))
  invitationId String
  title        String
  date         String? // Format bebas: "Januari 2020"
  description  String   @db.Text
  imageUrl     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, sortOrder])
}

/// Galeri foto/video undangan
model Gallery {
  id           String    @id @default(uuid(7))
  invitationId String
  mediaUrl     String
  thumbnailUrl String?
  type         MediaType @default(PHOTO)
  caption      String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, sortOrder])
}

/// Amplop digital / rekening tujuan hadiah
model Gift {
  id            String   @id @default(uuid(7))
  invitationId  String
  type          GiftType // BANK | EWALLET | PHYSICAL
  providerName  String // Contoh: "BCA", "GoPay", "Tokopedia"
  accountName   String
  accountNumber String?
  qrCodeUrl     String?
  note          String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, sortOrder])
}

// =============================================================================
// DOMAIN 4: GUEST & RSVP
// =============================================================================

/// Daftar tamu undangan
model Guest {
  id           String    @id @default(uuid(7))
  invitationId String
  name         String
  whatsapp     String?
  uniqueCode   String    @unique // Digunakan untuk link personal & QR check-in
  isOpened     Boolean   @default(false)
  openedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  rsvp       RSVP?

  // uniqueCode sudah ter-index oleh @unique
  @@index([invitationId])
}

/// Konfirmasi kehadiran tamu
model RSVP {
  id           String     @id @default(uuid(7))
  invitationId String
  guestId      String?    @unique // Nullable: tamu anonim bisa RSVP tanpa uniqueCode
  name         String? // Jika tamu anonim
  attendance   Attendance
  pax          Int        @default(1)
  message      String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest      Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([invitationId, createdAt])
}

// =============================================================================
// DOMAIN 5: ANALYTICS
// =============================================================================

/// Log kunjungan halaman undangan
model VisitorLog {
  id           String   @id @default(uuid(7))
  invitationId String
  ipAddress    String? // Di-hash sebelum disimpan untuk privasi
  userAgent    String?  @db.Text
  referrer     String?
  visitedAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  // Analitik per-undangan dalam rentang waktu
  @@index([invitationId, visitedAt])
}

// =============================================================================
// DOMAIN 6: BLOG (SEO)
// =============================================================================

/// Artikel blog untuk SEO
model Post {
  id           String    @id @default(uuid(7))
  slug         String    @unique
  title        String
  excerpt      String?   @db.Text
  content      String    @db.Text
  thumbnailUrl String?
  authorId     String
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id])

  // slug sudah ter-index oleh @unique
  @@index([authorId])
  @@index([isPublished])
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  USER // Calon pengantin / pengguna biasa
  AGENCY // Wedding Organizer / Studio Foto
  ADMIN // Admin platform
  SUPER_ADMIN // Akses penuh ke CMS
}

enum GalleryLayout {
  CAROUSEL
  MASONRY
}

enum PackageType {
  ONE_TIME // Pembayaran sekali untuk akses terbatas waktu
  RECURRING // Berlangganan bulanan/tahunan
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum MediaType {
  PHOTO
  VIDEO
}

enum GiftType {
  BANK
  EWALLET
  PHYSICAL
}

enum Attendance {
  YES
  NO
  MAYBE
}

// =============================================================================
// DOMAIN 7: TEMPLATES & SETTINGS (Dikelola oleh Super Admin)
// =============================================================================

/// Templat ayat dan kutipan pilihan untuk undangan
model QuoteTemplate {
  id        String   @id @default(uuid(7))
  title     String // Contoh: "QS. Ar-Rum Ayat 21 (Islami)"
  content   String   @db.Text
  category  String   @default("General") // "Islami" | "Kristiani" | "Modern" | "Umum"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Pustaka lagu latar belakang pernikahan
model MusicTemplate {
  id        String   @id @default(uuid(7))
  title     String // Contoh: "Payung Teduh - Akad"
  url       String // URL file audio .mp3
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Daftar Tanya Jawab (FAQ) di Landing Page
model FAQ {
  id        String   @id @default(uuid(7))
  question  String // Pertanyaan
  answer    String   @db.Text // Jawaban
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Pengaturan Global Sistem (Key-Value) seperti nomor WhatsApp
model SystemSetting {
  id          String   @id @default(uuid(7))
  key         String   @unique // Contoh: "CS_WHATSAPP_NUMBER"
  value       String // Nilai pengaturan
  description String? // Deskripsi kegunaan
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
